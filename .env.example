# Copy to .env and fill in. Never commit .env.

# Secret path segment for the podcast feeds and audio (32+ chars).
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
FEED_TOKEN=

# Base URL your podcast app uses to reach the feeds, e.g. a Tailscale HTTPS name:
# https://your-server.your-tailnet.ts.net:8443  (see README: "Serving the feeds")
PUBLIC_BASE_URL=http://localhost:8430

# IANA time zone for episode dates and the daily schedule
BRIEF_TZ=America/Chicago

# Address docker-compose binds the UI to (e.g. `tailscale ip -4`, or your LAN IP).
TAILSCALE_IP=

# --- Daily news brief ---
# 0 = off; 1 (or api) = written by the Anthropic API (needs ANTHROPIC_API_KEY, roughly $3-4/month);
# worker = written by the Mac worker on your Claude plan (no API cost; see README "Daily brief")
DAILY_BRIEF=0
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5
RUN_AT=08:00
RETRY_AT=08:30
# worker mode: RUN_AT is when the server gathers stories; READY_BY is when a missing brief sends a push
# READY_BY=08:30
# Used in the story-selection prompt; pair it with local feeds in feeds.yaml
LISTENER_LOCATION=Minneapolis

# --- Personal segment (optional; DAILY_BRIEF=worker only) ---
# A short "Your morning" segment at the start of the daily brief: sleep and a tip from an Oura dashboard
# service exposing GET /api/state, and yesterday's spending from Actual Budget (via the actualpy library).
# PERSONAL_SEGMENT=1
# OURA_DASHBOARD_URL=http://172.17.0.1:8090
# ACTUAL_SERVER_URL=https://172.17.0.1:5006
# ACTUAL_PASSWORD=
# ACTUAL_SYNC_ID=
# ACTUAL_ENCRYPTION_PASSWORD=
# 1 = verify TLS with system CAs, 0 = don't verify (self-signed, own network only),
# or a path to the server's certificate file (trusts exactly that certificate; hostname not checked)
# ACTUAL_TLS_VERIFY=1
# Weather location override (default: look up LISTENER_LOCATION once with Open-Meteo's geocoder)
# WEATHER_LAT=44.98
# WEATHER_LON=-93.27

# --- Deep dives (researched by a scheduled Claude task on your Mac; no API cost) ---
# Worker API token (32+ chars). Empty disables the worker API.
WORKER_TOKEN=

# --- Push notifications (optional, via ntfy.sh) ---
# A long random topic name is the only secret: anyone who knows it can read your pushes.
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(24))'   Empty = no pushes.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# --- Speech ---
# Any Kokoro voice, e.g. am_michael, af_heart, af_bella, bf_emma
VOICE=am_michael

# Co-host voice for two-host deep dives
# COHOST_VOICE=af_heart

# Intro/outro music: a generated sting by default. Put intro.wav / outro.wav (PCM WAV, <= 30 s)
# in data/music/ to use your own. 0 = no music.
# MUSIC=0

# --- Send from your phone (optional) ---
# Token for the share-sheet Shortcut's POST /api/inbox (empty = off). See shortcuts/README.md.
# INBOX_TOKEN=

# --- Login and sharing (optional) ---
# Password for the web UI (empty = no login). Devices stay logged in for SESSION_DAYS (1-365, default 90).
# UI_PASSWORD=
# SESSION_DAYS=90
# Public https origin of your Tailscale Funnel, for per-episode share links (empty = no sharing).
# SHARE_BASE_URL=https://myserver.tailnet-name.ts.net
# 1 = also let Funnel reach /feed/ and /audio/ (for podcast apps that fetch from their own servers)
# FUNNEL_FEEDS=0

# --- Container user ---
# The app runs as this uid:gid (not root). Match the owner of ./data (`id -u`, `id -g`). Default 1000:1000.
# PUID=1000
# PGID=1000

# --- Development only ---
# Silent audio instead of Kokoro (Kokoro's espeak doesn't run on macOS)
# FAKE_SPEECH=1
# Deterministic offline writer instead of the Claude API (free, not a quality check)
# CLAUDE_OFFLINE=1
