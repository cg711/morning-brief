# Copy to .env and fill in. Never commit .env.

# Secret path segment for the podcast feeds and audio (32+ chars).
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
FEED_TOKEN=

# Base URL your podcast app uses to reach the feeds, e.g. a Tailscale HTTPS name:
# https://your-server.your-tailnet.ts.net:8443  (see README: "Serving the feeds")
PUBLIC_BASE_URL=http://localhost:8430

# IANA time zone for episode dates and the daily schedule
BRIEF_TZ=America/Chicago

# Address docker-compose binds the UI to (e.g. `tailscale ip -4`, or your LAN IP).
TAILSCALE_IP=

# --- Daily news brief (uses the Anthropic API, roughly $3-4/month with Sonnet) ---
# 1 = on (needs ANTHROPIC_API_KEY), 0 = off (no API calls at all)
DAILY_BRIEF=0
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-5
RUN_AT=08:00
RETRY_AT=08:30
# Used in the story-selection prompt; pair it with local feeds in feeds.yaml
LISTENER_LOCATION=Minneapolis

# --- Deep dives (researched by a scheduled Claude task on your Mac; no API cost) ---
# Worker API token (32+ chars). Empty disables the worker API.
WORKER_TOKEN=

# --- Push notifications (optional, via ntfy.sh) ---
# A long random topic name is the only secret: anyone who knows it can read your pushes.
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(24))'   Empty = no pushes.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# --- Speech ---
# Any Kokoro voice, e.g. am_michael, af_heart, af_bella, bf_emma
VOICE=am_michael

# --- Container user ---
# The app runs as this uid:gid (not root). Match the owner of ./data (`id -u`, `id -g`). Default 1000:1000.
# PUID=1000
# PGID=1000

# --- Development only ---
# Silent audio instead of Kokoro (Kokoro's espeak doesn't run on macOS)
# FAKE_SPEECH=1
# Deterministic offline writer instead of the Claude API (free, not a quality check)
# CLAUDE_OFFLINE=1
